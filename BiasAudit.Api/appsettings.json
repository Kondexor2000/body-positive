{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=bias_audit;Username=bias_audit;Password=bias_audit"
  },
  "ApiKey": {
    "HeaderName": "X-Api-Key",
    "Value": "dev-api-key-change-me"
  },
  "Storage": {
    "BucketName": "bias-audits",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Region": "us-east-1",
    "ServiceUrl": "http://localhost:9000",
    "ForcePathStyle": true
  },
  "NudeNet": {
    "BaseUrl": "http://localhost:8081",
    "DetectPath": "/detect",
    "UseMockWhenUnavailable": true
  },
  "Audit": {
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
